{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rep.sinetti.ai/schemas/reputation-card.schema.json",
  "title": "ReputationCard",
  "description": "Aggregate wallet reputation across indexed Sinetti deployments. No transaction-level detail is exposed.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "deals_settled": {
      "type": "integer",
      "minimum": 0
    },
    "outcomes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "release": {
          "type": "integer",
          "minimum": 0
        },
        "refund": {
          "type": "integer",
          "minimum": 0
        },
        "refund_and_slash": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "release",
        "refund",
        "refund_and_slash"
      ]
    },
    "rates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "success_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "dispute_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "timeout_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "success_rate",
        "dispute_rate",
        "timeout_rate"
      ]
    },
    "bonds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "posted_count": {
          "type": "integer",
          "minimum": 0
        },
        "slashed_count": {
          "type": "integer",
          "minimum": 0
        },
        "returned_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "posted_count",
        "slashed_count",
        "returned_count"
      ]
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "as_buyer": {
          "type": "integer",
          "minimum": 0
        },
        "as_seller": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "as_buyer",
        "as_seller"
      ]
    },
    "repeat_counterparty": {
      "type": "boolean"
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "distinct_counterparties": {
          "type": "integer",
          "minimum": 0
        },
        "independent_counterparty_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "distinct_counterparties",
        "independent_counterparty_share"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operator_verified": {
          "type": "integer",
          "minimum": 0
        },
        "self_adjudicated": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "operator_verified",
        "self_adjudicated"
      ]
    },
    "trust_tier": {
      "type": "string",
      "enum": [
        "unverified",
        "accountable",
        "reputation_bearing"
      ]
    },
    "identity_anchor": {
      "description": "Whether this wallet's settled deals carry a recorded legal identity, per docs/standards/identity-anchor.md. An empty `anchors` with a non-zero `deals_without_anchor` means the escrow had the slot and no deal filled it \u2014 NOT an identity that failed to verify. Anchors are keccak commitments over a public register and are not confidential.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "anchors": {
          "description": "Distinct non-zero anchors seen across the subject's settled deals, sorted. More than one means the wallet traded under more than one recorded identity.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          }
        },
        "deals_with_anchor": {
          "type": "integer",
          "minimum": 0
        },
        "deals_without_anchor": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "anchors",
        "deals_with_anchor",
        "deals_without_anchor"
      ]
    },
    "settled_volume": {
      "description": "Computed internally. The Slice 1 public API deliberately omits volume to reduce wallet financial profiling.",
      "type": "object", "additionalProperties": false,
      "properties": { "amount": { "type": "string", "pattern": "^[0-9]+$" }, "token": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" }, "human": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" } },
      "required": ["amount", "token", "human"]
    }
  },
  "required": ["address", "started_at", "deals_settled", "outcomes", "rates", "bonds", "roles", "repeat_counterparty", "graph", "provenance", "trust_tier", "identity_anchor"]
}
