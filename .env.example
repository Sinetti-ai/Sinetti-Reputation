SEPOLIA_RPC_URL=https://your-sepolia-rpc.example
LOCAL_RPC_URL=http://127.0.0.1:18546
# Selects which deployment (local|sepolia) the indexer reads.
RPC_DEPLOYMENT=local
LOCAL_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
DATABASE_PATH=./data/sinetti-rep.db
PORT=3000
# Defaults to loopback; set an explicit private interface for previews (for example, Tailscale), never 0.0.0.0 in production.
HOST=127.0.0.1
LOG_CHUNK_SIZE=2000
CONFIRMATIONS=5
POLL_INTERVAL_MS=15000

# Only for scripts/register-erc8004.ts: the key of the wallet being registered as an agent.
# REGISTRANT_PRIVATE_KEY=

# ERC-8004 registry scans: one RPC per registry name, or one shared URL for all.
# ERC8004_RPC_URL_ETHEREUM_SEPOLIA=
# ERC8004_RPC_URL_BASE_SEPOLIA=
# ERC8004_RPC_URL_ETHEREUM=
# ERC8004_RPC_URL_BASE=
# ERC8004_RPC_URL=

# Feedback and registration files: IPFS gateway for ipfs:// URIs, files checked per pass.
# IPFS_GATEWAY=https://ipfs.io/ipfs/
# CHECK_BATCH=200

# Public RPCs sometimes answer a populated log window empty. Re-asks per window and spacing.
# LOG_EMPTY_RETRIES=5
# LOG_EMPTY_RETRY_DELAY_MS=400

# Base URL the publisher writes into feedbackURI; must be where this API is reachable.
# PUBLIC_BASE_URL=https://rep.sinetti.ai

# Only for scripts/publish-erc8004.ts: the rater's key and the wallet-to-agentId map.
# ERC8004_PRIVATE_KEY=
# ERC8004_AGENT_IDS=0xSELLER=42
